[alias]
    a = add
    bt = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset%n' --abbrev-commit --date=relative --branches
    c = commit
    ca = commit --amend
    cae = commit --amend --no-edit
    ch = "!f(){ git branch --sort=-committerdate | fzf --height=20 | xargs git checkout; };f"
    d = "!f(){ git diff --name-only $@ | fzf -m --ansi --preview \"git diff --color=always -- {-1}\"; };f"
    dc = diff --cached
    fixup = "!f(){ git log --color=always --reverse --pretty=tformat:'%Cred%h%Creset - %s %Cgreen(%an %ar)%Creset' $(git symbolic-ref refs/remotes/origin/HEAD --short).. | fzf --ansi | cut -d"-" -f1 | xargs git commit ${1} --fixup; };f"
    gen = "!f(){ git commit --message=\"$(git show-branch --no-name HEAD | sed -E 's/^[a-z]{1,5}/gen/')\"; };f"
    ia = "!f(){ git diff --name-only $@ | fzf -m --print0 --ansi --preview \"git diff --color=always -- {-1}\" | xargs -0 git add; };f"
    l = log --graph --pretty=tformat:'%Cred%h%Creset -%C(auto)%d%Creset %s %Cgreen(%an %ar)%Creset'
    merged-branches = "!git branch --merged $(basename $(git symbolic-ref refs/remotes/origin/HEAD))"
	open = "!f() { url=$(git remote get-url origin | sed \"s|\\.git$||; s|git@github.com:|https://github.com/|; s|ssh://git@github.com/|https://github.com/|\"); default=$(git symbolic-ref refs/remotes/origin/HEAD | sed \"s|refs/remotes/origin/||\"); if [ -z \"$1\" ]; then open -u \"$url\"; else prefix=$(git rev-parse --show-prefix); open -u \"$url/blob/$default/${prefix}$1\"; fi; }; f"
    p = push origin
    pl = push --force-with-lease origin
    r = "!f(){ git fetch && git rebase $(git symbolic-ref refs/remotes/origin/HEAD --short); };f"
    ra = rebase --abort
    rc = rebase --continue
    radd = "!f(){ git add $(git diff --cached --name-only --diff-filter=ACMRTU); };f"
    ri = "!f(){ git rebase --autosquash --interactive $(git symbolic-ref refs/remotes/origin/HEAD --short); };f"
    sru = "!f(){ git remote update && git stash && git rebase $(git symbolic-ref refs/remotes/origin/HEAD --short) && git stash pop; };f"
    sri = "!f(){ git remote update && git stash && git rebase --interactive $(git symbolic-ref refs/remotes/origin/HEAD --short) && git stash pop; };f"
    s = "!f(){ gitu; };f"
    st =  -c core.quotePath=false status
    unstage = reset HEAD --
    uncommit = reset HEAD~
[color]
    ui = true
[color "branch"]
    upstream = cyan
[color "diff"]
    meta = yellow
    frag = magenta bold
    commit = yellow bold
    old = red bold
    new = green bold
    whitespace = red reverse
[color "diff-highlight"]
    oldNormal = red bold
    oldHighlight = red bold 52
    newNormal = green bold
    newHighlight = green bold 22
[commit]
	verbose = true
[core]
    whitespace = -trailing-space
    editor = hx
    excludesfile = ~/.gitignore_global
[credential]
    helper = cache --timeout=86400
[diff]
    algorithm = histogram
    colorMoved = plain
    colormovedws = allow-indentation-change
    # external = "difft"
    mnemonicPrefix = true
    renames = true
    submodule = log
    wordRegex = .
[fetch]
    recurseSubmodules = on-demand
[filter "lfs"]
    clean = git-lfs clean -- %f
    smudge = git-lfs smudge -- %f
    process = git-lfs filter-process
    required = true
[grep]
    extendedRegexp = true
[interactive]
    singleKey = true
[log]
    abbrevCommit = true
[merge]
    conflictStyle = zdiff3
[mergetool]
    keepBackup = false
    keepTemporaries = false
    prompt = false
[protocol]
    version = 2
[pull]
    rebase = true
[push]
    default = current
[rebase]
    autosquash = true
    autostash = true
[status]
    submoduleSummary = true
    showUntrackedFiles = all
[tag]
    sort = version:refname
[user]
    name = "Jérôme Pin"
    email = jeromepin@users.noreply.github.com
[init]
	defaultBranch = master
